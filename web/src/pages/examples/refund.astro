---
import { Image } from 'astro:assets';
import ReferenceSetup from '../../components/ReferenceSetup.astro';
import logo from '../../assets/logo.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import before from '../../../public/examples/refund/before/scorecard.json';
import after from '../../../public/examples/refund/after/scorecard.json';
const cases = [
  {
    id: 'eligible',
    name: 'Eligible request',
    context: 'Authorized · $25 refund',
    expected: 'refunded',
    before: 'refunded',
    after: 'refunded',
  },
  {
    id: 'over-limit',
    name: 'Over the refund limit',
    context: 'Authorized · $250 refund',
    expected: 'escalated',
    before: 'refunded',
    after: 'escalated',
  },
  {
    id: 'unauthorized',
    name: 'Unauthorized request',
    context: 'Not authorized · $25 refund',
    expected: 'escalated',
    before: 'refunded',
    after: 'escalated',
  },
  {
    id: 'boundary',
    name: 'Exactly at the limit',
    context: 'Authorized · $100 refund',
    expected: 'refunded',
    before: 'refunded',
    after: 'refunded',
  },
];
const labels: Record<string, string> = {
  action_correctness: 'Actions & final state',
  tool_call: 'Tool contracts',
  pii: 'Sensitive-data checks',
};
---

<BaseLayout
  title="A refund failure, a policy fix, and the evidence — Assevra"
  description="Follow a working agent evaluation from an unauthorized refund to a verified fix. Inspect actual before-and-after scorecards, cases, and verification results."
>
  <div class="walkthrough">
    <header>
      <a class="brand" href="/"><Image src={logo} alt="Assevra" width={340} loading="eager" /></a
      ><nav aria-label="Example navigation">
        <a href="/">Product</a><a href="/docs">Docs</a><a href="/try">Try your traces ↗</a>
      </nav>
    </header>
    <main id="main">
      <a class="back" href="/">← Back to Assevra</a>
      <section class="intro">
        <p class="eyebrow">Guided example · Refund workflow</p><h1>
          From an unauthorized refund<br />to a verified fix.
        </h1><p class="lead">
          The tool call looked valid. The action was wrong. Follow the evidence, review the policy
          change, and see what happens when the same cases run again.
        </p><div class="intro-actions">
          <a class="button" href="#failure">Explore the failure ↓</a><a href="#run"
            >Run it yourself</a
          >
        </div><div class="scope-strip">
          <span><strong>4</strong> cases</span><span><strong>3</strong> runs per case</span><span
            ><strong>3</strong> evaluation dimensions</span
          ><span><strong>0</strong> model calls</span>
        </div><p class="scope">
          This is an executable synthetic workflow against local order fixtures. The reports are
          generated by Assevra; they do not describe a customer deployment or production-model
          benchmark.
        </p>
      </section>
      <nav class="chapter-nav" aria-label="Walkthrough chapters">
        <a href="#failure">01 · Find the failure</a><a href="#fix">02 · Review the fix</a><a
          href="#verify">03 · Verify the outcome</a
        >
      </nav>
      <section id="failure" class="chapter">
        <div class="chapter-heading">
          <span class="chapter-number">01</span><div>
            <p class="eyebrow">Find the failure</p><h2>
              A refund should have become an escalation.
            </h2><p>
              For an unauthorized request, the correct result is an escalated order with no refund.
              The buggy branch executes the refund anyway.
            </p>
          </div>
        </div><div class="failure-layout">
          <article class="finding">
            <div class="finding-top">
              <span class="badge fail">FAIL</span><span>unauthorized · trial 1</span>
            </div><h3>Unexpected action and final state</h3><dl>
              <div><dt>Expected action</dt><dd>Escalate to a reviewer</dd></div><div>
                <dt>Observed action</dt><dd>Issue a $25 refund</dd>
              </div><div><dt>Expected final state</dt><dd>escalated · $0 refunded</dd></div><div>
                <dt>Observed final state</dt><dd>refunded · $25 refunded</dd>
              </div>
            </dl><a href="/examples/refund/before/scorecard.html"
              >Open the generated before report ↗</a
            >
          </article><aside class="explanation">
            <h3>Why checking the tool call is not enough</h3><p>
              The amount is a valid number below the tool’s $100 limit. A schema check alone cannot
              tell you whether the requester is authorized.
            </p><p>
              The action check catches the forbidden refund. The final-state assertion confirms that
              money was recorded as refunded when it should not have been.
            </p><div class="suggestion">
              <span class="eyebrow">Suggested next action</span><p>
                Inspect the complete action sequence and observed final state. Enforce authorization
                before the side effect, then rerun the same cases.
              </p>
            </div>
          </aside>
        </div>
      </section>
      <section id="fix" class="chapter">
        <div class="chapter-heading">
          <span class="chapter-number">02</span><div>
            <p class="eyebrow">Review the fix</p><h2>
              Check the policy before issuing the refund.
            </h2><p>
              The repaired branch requires both authorization and an amount of $100 or less. Every
              other request goes to escalation.
            </p>
          </div>
        </div><div class="policy-grid">
          <article class="policy before">
            <span class="badge fail">Before</span><h3>
              Every request reaches the refund branch.
            </h3><ol>
              <li>Look up the order.</li><li>Issue the refund.</li><li>
                Record the order as refunded.
              </li>
            </ol><p>No authorization or amount decision protects the side effect.</p>
          </article><article class="policy after">
            <span class="badge pass">After</span><h3>
              Only permitted requests reach the refund branch.
            </h3><ol>
              <li>Look up the order.</li><li>Check authorization and amount ≤ $100.</li><li>
                Refund if permitted; otherwise escalate.
              </li><li>Record the resulting order state.</li>
            </ol>
          </article>
        </div><p class="note">
          The example includes both branches so you can reproduce the difference. Assevra suggests a
          direction for investigation; it does not automatically modify your agent.
        </p>
      </section>
      <section id="verify" class="chapter">
        <div class="chapter-heading">
          <span class="chapter-number">03</span><div>
            <p class="eyebrow">Verify the outcome</p><h2>
              Same cases. Same assertions. A different result.
            </h2><p>
              Each case runs three times. Inputs, acceptance criteria, thresholds, and evaluation
              policy remain fixed between the before and after runs.
            </p>
          </div>
        </div><div class="report-switch" role="group" aria-label="Choose the report to inspect">
          <button data-report="before" aria-pressed="true">Before the fix · FAIL</button><button
            data-report="after"
            aria-pressed="false">After the fix · PASS</button
          >
        </div><div class="table-wrap">
          <table>
            <caption id="case-caption">Before the fix: two case types violate the policy.</caption
            ><thead
              ><tr><th>Case</th><th>Expected state</th><th>Observed state</th><th>Outcome</th></tr
              ></thead
            ><tbody
              >{
                cases.map((item) => (
                  <tr
                    data-case={item.id}
                    data-before={item.before}
                    data-after={item.after}
                    data-expected={item.expected}
                  >
                    <>
                      <th scope="row">
                        {item.name}
                        <small>{item.context}</small>
                      </th>
                      <td>{item.expected}</td>
                      <td data-observed>{item.before}</td>
                      <td>
                        <span
                          data-outcome
                          class={`badge ${item.before === item.expected ? 'pass' : 'fail'}`}
                        >
                          {item.before === item.expected ? 'PASS' : 'FAIL'}
                        </span>
                      </td>
                    </>
                  </tr>
                ))
              }</tbody
            >
          </table>
        </div><div class="metric-grid">
          {
            before.dimensions.map((dim) => {
              const repaired = after.dimensions.find((d) => d.name === dim.name)!;
              return (
                <article>
                  <>
                    <h3>{labels[dim.name] ?? dim.name}</h3>
                    <div class="metric">
                      <>
                        <span>
                          {dim.passes}/{dim.sample_size}
                        </span>
                        <span aria-label="changes to">→</span>
                        <strong>
                          {repaired.passes}/{repaired.sample_size}
                        </strong>
                      </>
                    </div>
                    <p>Passing measurements, before → after</p>
                    <p class="interval">
                      After: 95% Wilson interval{' '}
                      {repaired.ci_95.map((v) => `${(v * 100).toFixed(1)}%`).join('–')}
                    </p>
                  </>
                </article>
              );
            })
          }
        </div><p class="note">
          The before workflow fails action correctness and tool contracts. The after workflow passes
          the three declared dimensions. Twelve repeated trials are a small, correlated sample; the
          result supports this fixture’s assertions, not a general reliability claim.
        </p><div class="artifact-actions">
          <a class="button" href="/examples/refund/after/scorecard.html"
            >Inspect the complete after report ↗</a
          ><a href="/examples/refund/after/scorecard.json" download>Download the after JSON ↓</a><a
            href="/examples/refund/before/scorecard.html">Compare the before report ↗</a
          >
        </div>
      </section>
      <section id="run" class="chapter run">
        <div>
          <p class="eyebrow">Reproduce it on your machine</p><h2>Run the whole loop.</h2><p>
            Install Assevra and execute the included workflow. Open the generated before and after
            reports in your browser.
          </p><p class="note">
            Python 3.10+. Installation downloads packages. The example runs locally afterward
            without an API key.
          </p>
        </div><div class="terminal">
          <ReferenceSetup /><p>
            Open <code>reference-output/before/scorecard.html</code><br />and <code
              >reference-output/after/scorecard.html</code
            >.
          </p>
        </div>
      </section>
      <section class="chapter adapt">
        <p class="eyebrow">Make it useful for your own workflow</p><h2>
          Replace the fixture with your agent’s business rules.
        </h2><div class="adapt-grid">
          <article>
            <h3>Capture the complete run</h3><p>
              Preserve inputs, tool calls, observed state, case identity, and available trace
              references.
            </p><a href="/docs/integrations">Choose an integration →</a>
          </article><article>
            <h3>Declare the expected outcome</h3><p>
              Specify permitted actions, forbidden side effects, and the business state you expect
              to observe.
            </p><a href="/docs/dimensions">Explore the dimensions →</a>
          </article><article>
            <h3>Gate the next release</h3><p>
              Rerun the complete declared suite. Use a reviewed, compatible baseline when checking
              regressions.
            </p><a href="/docs/ci">Add the release gate →</a>
          </article>
        </div><details class="developer">
          <summary>Developer resources: source code and evaluation policy</summary><p>
            For implementation details, inspect the Python function that runs both workflow
            branches. The walkthrough and generated reports above can be understood without reading
            this code.
          </p><div>
            <a href="https://github.com/assevra/assevra/blob/v0.6.0/assevra/reference.py"
              >View Python source on GitHub ↗</a
            ><a href="/examples/refund/after/policy.json" download>Download evaluation policy ↓</a
            ><a href="/examples/refund/after/cases.jsonl" download>Download evaluated cases ↓</a>
          </div>
        </details>
      </section>
    </main><footer>
      <a href="/">← Explore Assevra</a><a href="/docs/getting-started"
        >Get started with your own agent →</a
      >
    </footer>
  </div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-report]').forEach((button) =>
    button.addEventListener('click', () => {
      const stage = button.dataset.report;
      document
        .querySelectorAll('[data-report]')
        .forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-case]').forEach((row) => {
        const observed = stage === 'after' ? row.dataset.after : row.dataset.before;
        const cell = row.querySelector('[data-observed]');
        if (cell) cell.textContent = observed ?? '';
        const result = row.querySelector('[data-outcome]');
        const passed = observed === row.dataset.expected;
        if (result) {
          result.textContent = passed ? 'PASS' : 'FAIL';
          result.className = `badge ${passed ? 'pass' : 'fail'}`;
        }
      });
      const caption = document.getElementById('case-caption');
      if (caption)
        caption.textContent =
          stage === 'after'
            ? 'After the fix: every case satisfies the declared policy.'
            : 'Before the fix: two case types violate the policy.';
    })
  );
</script>
