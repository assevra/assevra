---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import BaseLayout from '../layouts/BaseLayout.astro';
const GH = 'https://github.com/assevra/assevra';
const dimensions = [
  [
    'grounding',
    'Grounding',
    'Answers',
    'Does the answer follow from the sources?',
    'Compare claims with captured context using a model judge.',
  ],
  [
    'safety',
    'Safety & refusal',
    'Answers',
    'Does it refuse the right requests?',
    'Check both required refusals and permitted responses against labels.',
  ],
  [
    'pii',
    'Sensitive data',
    'Answers',
    'Did private information escape?',
    'Detect supported sensitive patterns, with optional Presidio coverage.',
  ],
  [
    'task_completion',
    'Task completion',
    'Answers',
    'Did the answer include what was required?',
    'Check explicit required strings; use outcome assertions for business state.',
  ],
  [
    'tool_call',
    'Tool contracts',
    'Actions',
    'Were the arguments valid and permitted?',
    'Validate full tool schemas, allowed calls, and expected arguments.',
  ],
  [
    'action_correctness',
    'Actions & outcomes',
    'Actions',
    'Did the workflow do the right thing?',
    'Assert action order, forbidden side effects, and observed final state.',
  ],
  [
    'injection',
    'Prompt injection',
    'Actions',
    'Did untrusted content redirect the agent?',
    'Evaluate labeled injection cases with canaries or a configured judge.',
  ],
  [
    'cost',
    'Cost budgets',
    'Operations',
    'Did the run stay within budget?',
    'Use recorded cost or token usage with your explicit price table.',
  ],
  [
    'latency',
    'Latency budgets',
    'Operations',
    'Did the workflow finish in time?',
    'Compare recorded duration with your budget and inspect timing summaries.',
  ],
];
const scenarios = [
  {
    title: 'Customer support & RAG',
    label: 'Trust the answer',
    body: 'Catch unsupported policy claims, leaked identifiers, and instructions hidden in retrieved content.',
    checks: 'Grounding · PII · Injection',
    next: 'Review sources, repair the retrieval or response policy, then rerun labeled cases.',
    href: '/docs/dimensions',
  },
  {
    title: 'Refunds & business workflows',
    label: 'Trust the action',
    body: 'Catch unauthorized refunds and incorrect final state—even when the tool call is well-formed.',
    checks: 'Actions · Tool contracts · Final state',
    next: 'Move authorization before the side effect and verify the resulting order state.',
    href: '/examples/refund',
  },
  {
    title: 'Agent pipelines in production',
    label: 'Control the release',
    body: 'Check captured runs against cost, latency, and correctness requirements before shipping a change.',
    checks: 'Budgets · Required coverage · Regression checks',
    next: 'Compare the full suite against a compatible, reviewed baseline in CI.',
    href: '/docs/ci',
  },
];
const benefits = [
  ['Connect your existing runs.', 'Import traces or capture your own agent command.'],
  ['Know what to fix next.', 'Get case-level findings, suggested actions, and verification steps.'],
  [
    'Make the release decision explicit.',
    'Block missing required evidence as well as failed checks.',
  ],
  ['Keep the evidence.', 'Export portable HTML and JSON; optionally sign the JSON scorecard.'],
];
const integrations = [
  [
    'Python / command line',
    'SDK + recorder',
    'Evaluate records in memory, or capture a command you provide.',
  ],
  [
    'LangGraph',
    'Capture recipe',
    'Retain tool calls across the message history and label workflow outcomes.',
  ],
  [
    'OpenAI Agents SDK',
    'Capture recipe',
    'Export run items, tool calls, and final output to the generic adapter.',
  ],
  [
    'OpenTelemetry / Phoenix',
    'Trace adapter',
    'Read supported OTLP and OpenInference exports with trace and span identity.',
  ],
  ['Langfuse', 'Export recipe', 'Bring observations into a local evaluation dataset.'],
  [
    'MCP / OpenAI / Anthropic tools',
    'Contract import',
    'Check recorded arguments against your tool definitions, including nested constraints.',
  ],
];
---

<BaseLayout
  title="Assevra — Find agent failures before your users do"
  description="Open-source agent evaluation with actionable findings, explicit release gates, and portable evidence. Connect captured runs, fix failing cases, and verify the change."
>
  <div class="release-strip">
    Open source · MIT · v0.6.0 <a href={`${GH}/blob/main/CHANGELOG.md`}>See what changed ↗</a>
  </div>
  <div class="home-wrap">
    <header class="home-header">
      <a href="/" class="wordmark" aria-label="Assevra home"
        ><Image src={logo} alt="Assevra" width={340} loading="eager" /></a
      >
      <nav aria-label="Main navigation">
        <a href="#dimensions">Capabilities</a><a href="#workflow">How it works</a><a
          href="#integrations">Integrations</a
        ><a href="/docs">Docs</a><a href={GH}>GitHub ↗</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero">
        <div>
          <p class="eyebrow">Agent evaluation. From failure to verified fix.</p>
          <h1>
            Find agent failures<br /><span class="headline-accent">before your users do.</span>
          </h1>
          <p class="intro">
            Turn captured agent runs into a clear decision: what failed, what to change, and whether
            the fix holds.
          </p>
          <ul class="benefits">
            {
              benefits.map(([title, body]) => (
                <li>
                  <strong>{title}</strong> {body}
                </li>
              ))
            }
          </ul>
          <p class="onboarding-promise">Try a sample scorecard in under 5 minutes.</p>
          <a class="button primary" href="/try">Get your first scorecard <span>→</span></a>
          <a class="text-link" href="/examples/refund">Explore a failure and its fix →</a>
          <p class="fine">
            No signup. No installation. Use the sample or drop in your own trace. Browser scans
            provide initial triage; full release checks require setup.
          </p>
        </div>
        <div class="evidence-panel">
          <div class="panel-heading">
            <span><span class="live-dot"></span> Refund workflow</span><span class="fine"
              >Executable synthetic example</span
            >
          </div>
          <div class="example-tabs" role="group" aria-label="Example stage">
            <button data-stage="before" aria-pressed="true">01 · Find the failure</button>
            <button data-stage="fix" aria-pressed="false">02 · Review the fix</button>
            <button data-stage="after" aria-pressed="false">03 · Verify</button>
          </div>
          <div class="example-content" aria-live="polite">
            <p id="example-status" class="example-status">FAIL · ACTION CORRECTNESS</p>
            <h2 id="example-title">A valid tool call can still be the wrong action.</h2>
            <p id="example-description">
              An unauthorized request triggered a refund. The workflow should have escalated it.
            </p>
            <div class="state-comparison">
              <div><span>Expected state</span><strong id="expected">escalated</strong></div><div>
                <span>Observed state</span><strong id="observed">refunded</strong>
              </div>
            </div>
            <div class="next-action">
              <span class="eyebrow">Next action</span><p id="example-action">
                Enforce authorization and the refund limit before executing the tool. Rerun the same
                cases and inspect final state.
              </p>
            </div>
            <a id="example-artifact" href="/examples/refund/before/scorecard.html"
              >Inspect the generated scorecard ↗</a
            >
            <p class="scope">
              4 cases · 3 runs per case · action, tool contract, and PII checks. A local fixture,
              with no model calls or customer data.
            </p>
          </div>
        </div>
      </section>
      <div class="stack-band" aria-label="Supported integration paths">
        <span>Fits your existing stack</span><strong>LangGraph</strong><strong>OpenAI Agents</strong
        ><strong>OpenTelemetry</strong><strong>Langfuse</strong><strong>Phoenix</strong><strong
          >MCP tool schemas</strong
        ><a href="#integrations">See integration types ↓</a>
      </div>
      <section class="section" id="use-cases">
        <p class="eyebrow">Start with the failure your team cannot afford</p><h2>
          Built around the work your agent does.
        </h2><div class="scenario-grid">
          {
            scenarios.map((item) => (
              <article class="scenario-card">
                <>
                  <span class="eyebrow">{item.label}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <div class="check-label">{item.checks}</div>
                  <p class="scenario-next">
                    <strong>Then act:</strong> {item.next}
                  </p>
                  <a href={item.href}>
                    {item.href === '/examples/refund'
                      ? 'Explore the refund walkthrough'
                      : 'Explore the evaluation approach'}{' '}
                    →
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </section>
      <section class="section capability-section" id="dimensions">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Nine dimensions. One inspectable decision.</p><h2>
              Look beyond the final answer.
            </h2>
          </div><p>
            Inspect what the agent said, what it did, and what the run cost. Choose the checks your
            release actually requires.
          </p>
        </div><div
          class="dimension-filters"
          role="group"
          aria-label="Filter evaluation capabilities"
        >
          {
            ['All', 'Answers', 'Actions', 'Operations'].map((category) => (
              <button data-category={category} aria-pressed={category === 'All' ? 'true' : 'false'}>
                {category}
              </button>
            ))
          }
        </div><p class="filter-summary" id="filter-summary" aria-live="polite">
          Showing all 9 dimensions
        </p><div class="dimension-grid">
          {
            dimensions.map(([id, name, group, question, detail], index) => (
              <article class="dimension-card" data-dimension-group={group}>
                <>
                  <div class="dimension-meta">
                    <>
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <span>{group}</span>
                    </>
                  </div>
                  <h3>{name}</h3>
                  <p class="dimension-question">{question}</p>
                  <p>{detail}</p>
                  <a href="/docs/dimensions" aria-label={`Read about ${name}`}>
                    Explore <span aria-hidden="true">→</span>
                  </a>
                  <span class="dimension-id">{id}</span>
                </>
              </article>
            ))
          }
        </div><p class="fine">
          Model judgments require calibration against representative human labels. Detector and rule
          coverage depend on the configuration; a passing fixture does not establish general
          reliability.
        </p>
      </section>
      <section class="workflow section" id="workflow">
        <p class="eyebrow">A scorecard should start the next step.</p><h2>
          Capture. Diagnose. Fix. Verify.
        </h2>
        <div class="step-grid">
          <article>
            <span class="step-number">01</span><h3>Use the runs you have</h3><p>
              Import traces, evaluate Python records, or capture a command. Declare the outcomes and
              dimensions that matter to your workflow.
            </p>
          </article>
          <article>
            <span class="step-number">02</span><h3>Inspect the failing case</h3><p>
              See the assertion, case identity, trace reference, and suggested next action.
              Evaluator errors stay separate from agent failures.
            </p>
          </article>
          <article>
            <span class="step-number">03</span><h3>Make a reviewed change</h3><p>
              Repair the prompt, tool boundary, retrieval, or workflow. Suggestions guide your
              investigation; they do not modify your agent.
            </p>
          </article>
          <article>
            <span class="step-number">04</span><h3>Rerun the release suite</h3><p>
              Check the same inputs and policy. Required missing checks block release; compatible
              history enables regression comparison.
            </p>
          </article>
        </div>
      </section>
      <section class="section starter" id="start">
        <div>
          <p class="eyebrow">Start with a working example</p><h2>
            Watch a failure become a verified fix.
          </h2><p>
            Run the included refund workflow before and after its authorization fix. Open both
            reports, inspect the findings, then adapt the assertions to your own agent.
          </p><p class="fine">
            Python 3.10+. Installation downloads packages. This example runs locally without API
            keys.
          </p>
        </div>
        <div class="terminal">
          <div class="terminal-heading">
            YOUR TERMINAL <button id="copy-example" type="button">Copy commands</button>
          </div><pre><code id="example-command">pip install assevra==0.6.0
python -m assevra.reference --out-dir reference-output</code></pre><div
            class="terminal-result"
          >
            <span>before → FAIL</span><span>after → PASS</span>
          </div><p>Open <code>reference-output/after/scorecard.html</code></p><a
            href="/examples/refund">Explore the complete walkthrough →</a
          >
        </div>
      </section>
      <section class="section" id="integrations">
        <p class="eyebrow">Fits around your agent pipeline</p><h2>
          Bring your framework. Keep your infrastructure.
        </h2><p class="section-intro">
          Assevra evaluates captured evidence. Start with an adapter or recipe, then supply your
          business assertions. Integration types are listed explicitly below.
        </p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Your stack</th><th>Available today</th><th>How it helps</th></tr></thead
            ><tbody
              >{
                integrations.map(([name, type, detail]) => (
                  <tr>
                    <>
                      <td>
                        <strong>{name}</strong>
                      </td>
                      <td>
                        <span class="integration-type">{type}</span>
                      </td>
                      <td>{detail}</td>
                    </>
                  </tr>
                ))
              }</tbody
            >
          </table>
        </div>
        <p class="fine">
          Recipes and format adapters are covered by local tests. Hosted customer environments
          require your own smoke test. These are integrations, not vendor partnerships.
        </p><a href="/docs/integrations">Choose an integration →</a>
      </section>
      <section class="section proof-grid">
        <article>
          <p class="eyebrow">Evidence with boundaries</p><h2>
            A release decision you can inspect.
          </h2><p>
            Dimension pass rates include sample sizes and 95% Wilson intervals. Required checks
            cannot disappear behind a green headline. A scan is TRIAGE; a mock evaluator run is
            SELF_TEST.
          </p><p>
            Choose thresholds and coverage for your use case. Validate model judges against human
            labels before relying on their judgments.
          </p><a href={`${GH}/blob/main/METHODOLOGY.md`}>Read the methodology ↗</a>
        </article>
        <article>
          <p class="eyebrow">Open source, portable by design</p><h2>
            Your runs. Your artifacts.
          </h2><p>
            Keep reports in your repository or attach them to a release. JSON schemas are versioned.
            Optional Ed25519 signatures protect canonical scorecard JSON; trust depends on the
            signing key you verify.
          </p><p>
            Cloud judges receive the fields in their evaluation prompts. Use deterministic checks or
            a configured local judge when your data must stay local.
          </p><a href="/docs">Read the documentation →</a>
        </article>
      </section>
      <section class="section evidence-depth">
        <p class="eyebrow">More than a single score</p><h2>
          Evidence that travels with the release.
        </h2><div class="evidence-grid">
          <article>
            <span class="evidence-symbol" aria-hidden="true">↔</span><h3>
              Understand uncertainty
            </h3><p>
              See sample sizes and Wilson intervals alongside dimension pass rates. Use repeated
              trials to inspect consistency and pass^k.
            </p><a href="/docs/methodology">Measurement methodology →</a>
          </article><article>
            <span class="evidence-symbol" aria-hidden="true">≋</span><h3>Choose your judge</h3><p>
              Use Anthropic, OpenAI, Azure, Bedrock, Gemini, or a compatible local endpoint. Panel
              disagreement remains visible.
            </p><a href="/docs/calibration">Judge calibration →</a>
          </article><article>
            <span class="evidence-symbol" aria-hidden="true">✓</span><h3>Verify the artifact</h3><p>
              Sign canonical JSON with Ed25519. Share the portable report and verify it against a
              trusted public key.
            </p><a href="/docs/security">Signing and data flow →</a>
          </article><article>
            <span class="evidence-symbol" aria-hidden="true">▤</span><h3>
              Organize review evidence
            </h3><p>
              Generate an Agent Card with indicative mappings to NIST AI RMF, EU AI Act, ISO/IEC
              42001, and OWASP control families.
            </p><a href="/docs/governance">Explore Agent Cards →</a>
          </article>
        </div><p class="fine">
          Governance mappings help reviewers locate evidence; they are not a compliance
          determination or certification.
        </p>
      </section>
      <section class="section faq-section">
        <div>
          <p class="eyebrow">Before you connect your agent</p><h2>A few practical answers.</h2><a
            href="/docs/faq">Read the full FAQ →</a
          >
        </div><div class="faq-list">
          <details>
            <summary>Do I need to replace my tracing platform?</summary><p>
              No. Export supported traces or use the Python SDK and recorder. Assevra adds
              evaluation and release evidence around the runs you already capture.
            </p>
          </details><details>
            <summary>What should I do when a case fails?</summary><p>
              Inspect the case, trace, and acceptance criteria. Review the suggested action, change
              the agent, execute it again, and rerun the complete declared suite. <a
                href="/examples/refund">Follow the guided example.</a
              >
            </p>
          </details><details>
            <summary>Can I use Assevra without sending data to a cloud judge?</summary><p>
              Deterministic checks run locally after installation. A configured local model endpoint
              can handle model judgments. Cloud judges receive the fields in their rubric prompts.
            </p>
          </details><details>
            <summary>Can a partial scan approve a release?</summary><p>
              No. Scans are TRIAGE and mock runs are SELF_TEST. A release PASS requires completed
              evidence for every included and required dimension.
            </p>
          </details><details>
            <summary>Is Assevra open source?</summary><p>
              Yes, under the MIT license. The code, methodology, versioned schemas, and release
              archives are public. You can extend scorers and reporters through the Python SDK.
            </p>
          </details>
        </div>
      </section>
      <section class="closing">
        <h2>Make the next agent release easier to trust.</h2><a class="button primary" href="#start"
          >Run the example ↑</a
        ><a class="text-link" href={`${GH}/issues/new/choose`}>Share feedback ↗</a>
      </section>
    </main>
    <footer>
      <a class="wordmark" href="/"><Image src={logo} alt="Assevra" width={340} loading="eager" /></a
      ><p>Open-source release evidence for AI agents.</p><div>
        <a href={GH}>GitHub</a><a href="https://pypi.org/project/assevra/">PyPI</a><a
          href="https://doi.org/10.5281/zenodo.21200852">Cite Assevra</a
        ><a href="/docs">Documentation</a>
      </div>
    </footer>
  </div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.category;
      let visible = 0;
      document
        .querySelectorAll<HTMLButtonElement>('[data-category]')
        .forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-dimension-group]').forEach((card) => {
        card.hidden = category !== 'All' && card.dataset.dimensionGroup !== category;
        if (!card.hidden) visible++;
      });
      const summary = document.getElementById('filter-summary');
      if (summary)
        summary.textContent =
          category === 'All'
            ? 'Showing all 9 dimensions'
            : `Showing ${visible} ${category?.toLowerCase()} dimensions`;
    });
  });
  const states = {
    before: {
      status: 'FAIL · ACTION CORRECTNESS',
      title: 'A valid tool call can still be the wrong action.',
      description:
        'An unauthorized request triggered a refund. The workflow should have escalated it.',
      observed: 'refunded',
      action:
        'Enforce authorization and the refund limit before executing the tool. Rerun the same cases and inspect final state.',
      artifact: 'before',
    },
    fix: {
      status: 'REVIEW · SUGGESTED CHANGE',
      title: 'Move the policy check before the side effect.',
      description:
        'Require an authorized request and an amount of $100 or less. Escalate every other request.',
      observed: 'review pending',
      action:
        'The example changes the workflow branch. Test eligible, unauthorized, over-limit, and boundary cases with the same assertions.',
      artifact: 'before',
    },
    after: {
      status: 'PASS · DECLARED SCOPE',
      title: 'The repaired workflow satisfies the same assertions.',
      description:
        'Unauthorized and over-limit requests now escalate. Eligible and boundary requests refund the expected amount.',
      observed: 'escalated',
      action:
        'Inspect the complete after report. All 12 trials pass the three declared dimensions; this fixture does not establish general model reliability.',
      artifact: 'after',
    },
  };
  document.querySelectorAll<HTMLButtonElement>('[data-stage]').forEach((button) => {
    button.addEventListener('click', () => {
      const stage = button.dataset.stage as keyof typeof states;
      const state = states[stage];
      document
        .querySelectorAll('[data-stage]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      for (const [id, value] of Object.entries({
        'example-status': state.status,
        'example-title': state.title,
        'example-description': state.description,
        observed: state.observed,
        'example-action': state.action,
      })) {
        const element = document.getElementById(id);
        if (element) element.textContent = value;
      }
      document.getElementById('example-status')?.setAttribute('data-verdict', stage);
      const link = document.getElementById('example-artifact') as HTMLAnchorElement;
      link.href = `/examples/refund/${state.artifact}/scorecard.html`;
    });
  });
  document.getElementById('copy-example')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(
        document.getElementById('example-command')?.textContent ?? ''
      );
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Select commands to copy';
    }
  });
</script>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .wordmark :global(img) {
    width: 165px;
    height: auto;
    mix-blend-mode: multiply;
  }
  @media (max-width: 450px) {
    .wordmark :global(img) {
      width: 136px;
    }
  }

  .stack-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    padding: 23px 0;
    border-top: 1px solid #dedde3;
    font-size: 12px;
    color: #56556a;
  }
  .stack-band > span {
    color: #787782;
    font-size: 11px;
  }
  .stack-band > a {
    color: #594ac4;
    margin-left: auto;
  }
  .scenario-grid,
  .dimension-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
  }
  .scenario-card {
    border: 1px solid #dddbe8;
    border-radius: 8px;
    padding: 26px;
    background: linear-gradient(145deg, #fff, #f4f2fb);
    display: flex;
    flex-direction: column;
  }
  .scenario-card h3 {
    font-size: 21px;
    margin: 12px 0;
  }
  .scenario-card p,
  .evidence-grid p,
  .faq-list p {
    font-size: 14px;
    color: #626370;
    line-height: 1.75;
  }
  .check-label {
    font-size: 11px;
    color: #5f4caa;
    padding: 12px 0;
    border-block: 1px solid #dedbe9;
    margin: 16px 0 0;
  }
  .scenario-card a {
    font-size: 13px;
    color: #594ac4;
    margin-top: auto;
    padding-top: 12px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 45px;
    align-items: end;
  }
  .section-heading > p {
    max-width: 360px;
    font-size: 14px;
    color: #626370;
  }
  .dimension-filters {
    display: flex;
    gap: 8px;
    margin-top: 26px;
  }
  .dimension-filters button {
    border: 1px solid #d9d5e8;
    border-radius: 25px;
    padding: 9px 18px;
    background: white;
    color: #5d586e;
    font-size: 12px;
    cursor: pointer;
  }
  .dimension-filters button[aria-pressed='true'] {
    background: #6255cf;
    color: white;
    border-color: #6255cf;
  }
  .filter-summary {
    font-size: 11px;
    color: #767180;
    margin: 13px 0 0;
  }
  .dimension-card {
    background: white;
    border: 1px solid #e0dde8;
    border-radius: 7px;
    padding: 23px;
    position: relative;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .dimension-card:hover {
    border-color: #a99dd8;
    box-shadow: 0 8px 24px #5144800a;
  }
  .dimension-card[hidden] {
