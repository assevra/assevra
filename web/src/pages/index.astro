---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import logo from '../assets/logo.png';

const GH = 'https://github.com/assevra/assevra';
const PYPI = 'https://pypi.org/project/assevra/';
const DOI = 'https://doi.org/10.5281/zenodo.21200852';
const METHOD = 'https://github.com/assevra/assevra/blob/main/METHODOLOGY.md';
const ROADMAP = 'https://github.com/assevra/assevra/blob/main/ROADMAP.md';
const CHANGELOG = 'https://github.com/assevra/assevra/blob/main/CHANGELOG.md';
const CASES = 'https://github.com/assevra/assevra/tree/main/examples/case-studies';
const EXAMPLE = '/example-scorecard.html';

const nav = [
  { label: 'Why', href: '#why' },
  { label: 'How it works', href: '#pipeline' },
  { label: 'What it measures', href: '#dimensions' },
  { label: 'Integrations', href: '#integrations' },
  { label: 'Docs', href: '/docs' },
];

const badges = [
  'MIT licensed',
  'Python 3.10+',
  'zero-dependency core',
  'runs fully offline',
  'DOI 10.5281/zenodo.21200852',
];

const frameworks = ['EU AI Act', 'NIST AI RMF', 'ISO/IEC 42001', 'OWASP LLM Top 10'];

const steps = [
  {
    n: '1',
    cmd: 'pip install assevra',
    label: 'Zero-dependency core. No account, no backend, nothing to log into.',
  },
  {
    n: '2',
    cmd: 'assevra demo',
    label:
      'A complete worked scorecard — HTML, JSON, Agent Card — with no clone, no API key and no network.',
  },
  {
    n: '3',
    cmd: 'assevra init --from traces.jsonl',
    label:
      'Detects your traces, framework and providers, then writes the config, a drafted dataset and a CI gate.',
  },
  {
    n: '4',
    cmd: 'assevra run --gate',
    label: 'Scores, gates the build, and writes the artifact you attach to the release.',
  },
];

const capabilities = [
  {
    title: 'A signed artifact, not a dashboard',
    body: 'One self-contained file — Markdown, JSON, and styled HTML — that you commit to git, attach to a PR, or mail to a reviewer. Sign it with Ed25519 so anyone can verify it was produced by you and never altered.',
    tag: 'assevra sign · verify',
    icon: 'shield',
  },
  {
    title: 'Honest error bars, on every number',
    body: 'A bare "0.92" hides how few samples it came from. Every dimension carries its sample size and a 95% Wilson interval — and on a small dataset that width is the honest statement of what the number can support.',
    tag: '95% Wilson CI',
    icon: 'chart',
  },
  {
    title: 'Deterministic before judge',
    body: 'You scan for a leaked SSN; you do not ask a model whether it leaked one. Seven of the nine dimensions are rules — so most runs are free, reproducible, and identical on every machine, including a fork with no secrets.',
    tag: '7 of 9 need no model',
    icon: 'rule',
  },
  {
    title: 'Skipped is never passed',
    body: 'A dimension whose engine was unavailable is reported as SKIPPED and does not gate. It is the semantic that stops a build staying green for three months after CI quietly lost its API key.',
    tag: 'fails closed',
    icon: 'pulse',
  },
  {
    title: 'A published artifact contract',
    body: 'The scorecard, Agent Card, calibration report and dataset row all have versioned JSON Schemas served from this domain. Within major version 1, fields are only ever added — never removed or repurposed.',
    tag: 'schema/v1',
    icon: 'doc',
  },
  {
    title: 'Any model vendor, or none',
    body: 'Anthropic, OpenAI, Azure, Bedrock, Gemini — or any OpenAI-compatible local endpoint, with no third-party package and no data leaving the machine. A jury can span vendors, and disagreement is reported as signal.',
    tag: '7 judge providers',
    icon: 'jury',
  },
];

const pipeline = [
  { cmd: 'bootstrap', label: 'Draft a dataset from traces you already have' },
  { cmd: 'validate', label: 'LABELED / UNLABELED / INVALID — before scoring' },
  { cmd: 'run', label: 'Score every dimension, with its interval' },
  { cmd: 'calibrate', label: 'Prove the judge agrees with humans (κ ≥ 0.85)' },
  { cmd: 'sign', label: 'Seal the scorecard with Ed25519' },
  { cmd: 'attest', label: 'Map the evidence to governance frameworks' },
];

const scorecard = [
  { dim: 'Grounding', mode: 'llm-judge', score: '0.94', ci: '0.87–0.97', n: '80', thr: '0.90' },
  {
    dim: 'Safety / refusal',
    mode: 'llm-judge',
    score: '1.00',
    ci: '0.94–1.00',
    n: '60',
    thr: '1.00',
  },
  { dim: 'PII-leak', mode: 'deterministic', score: '1.00', ci: '0.95–1.00', n: '72', thr: '1.00' },
  {
    dim: 'Tool calls',
    mode: 'deterministic',
    score: '0.98',
    ci: '0.93–0.99',
    n: '96',
    thr: '0.95',
  },
  {
    dim: 'Prompt injection',
    mode: 'deterministic',
    score: '1.00',
    ci: '0.92–1.00',
    n: '44',
    thr: '1.00',
  },
];

const dimensions = [
  {
    name: 'Grounding',
    mode: 'llm-judge',
    q: 'Is every factual claim traceable to the provided context, or invented?',
    bar: '≥ 0.90',
  },
  {
    name: 'Safety / refusal',
    mode: 'llm-judge',
    q: 'Does it refuse what it must — and answer what it should? Over-refusal is a failure too.',
    bar: '1.00 · zero tolerance',
  },
  {
    name: 'PII-leak',
    mode: 'deterministic',
    q: 'Does personal data escape into an output, outside the field it was sanctioned to echo?',
    bar: '1.00 · zero tolerance',
  },
  {
    name: 'Task-completion',
    mode: 'deterministic',
    q: 'Are the facts a correct completion requires actually present?',
    bar: '≥ 0.90',
  },
  {
    name: 'Tool-call validation',
    mode: 'deterministic',
    q: 'Was every call well-formed, permitted, and complete — arguments, types, enums and all?',
    bar: '≥ 0.95',
  },
  {
    name: 'Action correctness',
    mode: 'deterministic',
    q: 'Did it do the right thing? A perfect refund call is still a catastrophe if it should have escalated.',
    bar: '≥ 0.95',
  },
  {
    name: 'Prompt injection',
    mode: 'deterministic',
    q: 'Did it resist instructions planted in retrieved content, tool output, or another agent?',
    bar: '1.00 · zero tolerance',
  },
  {
    name: 'Cost budget',
    mode: 'deterministic',
    q: 'Did each run stay inside its cost budget? Priced from your table, not guessed.',
    bar: '≥ 0.95',
  },
  {
    name: 'Latency budget',
    mode: 'deterministic',
    q: 'Did each run finish in time? Reported as a pass rate with p50/p95, because averages hide the tail.',
    bar: '≥ 0.95',
  },
];

const integrations = [
  { name: 'OpenTelemetry', note: 'OpenInference & OpenLLMetry spans' },
  { name: 'LangGraph', note: 'state + tool calls' },
  { name: 'Langfuse', note: 'observation export' },
  { name: 'Arize Phoenix', note: 'OpenInference spans' },
  { name: 'OpenAI Agents SDK', note: 'run traces' },
  { name: 'Anthropic', note: 'Messages API logs' },
];

const providers = ['Anthropic', 'OpenAI', 'Azure', 'Bedrock', 'Gemini', 'Local / self-hosted'];

const cases = [
  {
    title: 'RAG support assistant',
    href: `${CASES}/rag-assistant`,
    dims: 'grounding · injection · pii',
    body: 'An indirect prompt injection arriving through a product review — nothing the user did wrong, and nothing input validation would have caught.',
  },
  {
    title: 'Commerce agent with real tools',
    href: `${CASES}/commerce-agent`,
    dims: 'tool-call · action · cost · latency',
    body: 'A malformed call and a wrong decision look identical in a trace and are completely different problems. Also: 41,000 tokens to answer “where is my order?”',
  },
  {
    title: 'Multi-agent claims workflow',
    href: `${CASES}/multi-agent-workflow`,
    dims: 'pass^k · handoffs · agent-to-agent injection',
    body: 'A dimension scoring 0.667 with consistency 0.000 is not a quality problem. It is an agent that never behaves the same way twice.',
  },
];

const SIGNING_KEY = 'dEcTKT/9ThXewTjRdBm2qyGIH69Ghy08kVuB19AJnSg=';
---

<BaseLayout
  title="Assevra — release evidence for AI agents"
  description="Assevra turns agent test runs into signed, statistically defensible scorecards that gate every release. Every number carries a 95% confidence interval. Runs offline, MIT licensed, no backend."
>
  <!-- Header -->
  <header class="hdr">
    <div class="container hdr-in">
      <a href="/" class="brand" aria-label="Assevra home">
        <Image src={logo} alt="Assevra" widths={[180, 260]} sizes="150px" loading="eager" />
      </a>
      <nav class="hdr-nav" aria-label="Primary">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="hdr-cta">
        <a href={GH} class="ghlink" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.36 1.1 2.94.84.09-.66.35-1.1.63-1.36-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
            ></path></svg
          >
          <span>Star</span>
        </a>
        <a href="/docs" class="btn btn-primary sm">Read the docs</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-in">
        <div class="hero-copy">
          <p class="eyebrow">Open source · release evidence for AI agents</p>
          <h1 class="hero-title">
            Trust your AI agents.<br /><span class="ht-accent">Let's prove it.</span>
          </h1>
          <p class="hero-sub">
            Assevra turns agent test runs into <strong
              >signed, statistically defensible scorecards</strong
            > that gate every release. Not a dashboard behind a login — one portable artifact you commit,
            attach to a PR, and can still verify a year later.
          </p>

          <div class="install" id="install">
            <code class="code" id="install-cmd">pip install assevra && assevra demo</code>
            <button type="button" class="copy" id="copy-btn" aria-label="Copy install command">
              Copy
            </button>
          </div>
          <p class="install-note">
            A complete worked scorecard in two commands — no clone, no API key, no network.
          </p>

          <div class="hero-actions">
            <a href="/docs/getting-started" class="btn btn-primary">Get started →</a>
            <a href={EXAMPLE} class="btn btn-ghost">See an example scorecard</a>
          </div>

          <ul class="badges">
            {badges.map((b) => <li class="pill">{b}</li>)}
          </ul>
        </div>

        <!-- Embedded scorecard artifact -->
        <div class="hero-visual">
          <div class="sc-card">
            <div class="sc-head">
              <div class="sc-title">
                <span class="sc-dot" aria-hidden="true"></span>
                Assevra Reliability Scorecard
              </div>
              <span class="sc-verdict">Overall · PASS</span>
            </div>
            <table class="sc-table">
              <thead>
                <tr>
                  <th>Dimension</th>
                  <th>Score</th>
                  <th class="hide-sm">95% CI</th>
                  <th class="hide-sm">n</th>
                  <th>Result</th>
                </tr>
              </thead>
              <tbody>
                {
                  scorecard.map((r) => (
                    <tr>
                      <td>
                        <span class="sc-dim">{r.dim}</span>
                        <span class="sc-mode mono">{r.mode}</span>
                      </td>
                      <td class="mono">{r.score}</td>
                      <td class="mono hide-sm">{r.ci}</td>
                      <td class="mono hide-sm">{r.n}</td>
                      <td>
                        <span class="sc-pass">PASS</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <div class="sc-foot mono">signed · Ed25519 · verifiable offline</div>
          </div>
        </div>
      </div>

      <!-- framework strip -->
      <div class="container">
        <div class="frameworks">
          <span class="fw-label mono">Speaks the language of your security review</span>
          <ul>
            {frameworks.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="section" id="why">
      <div class="container">
        <p class="eyebrow">The difference</p>
        <h2 class="section-title">Most eval tools ask “how good is my model?”</h2>
        <p class="section-lede">
          Assevra asks the only question a release meeting cares about: <strong
            >can I safely ship this agent?</strong
          > Everything below follows from that one change of question.
        </p>

        <div class="cap-grid">
          {
            capabilities.map((c) => (
              <article class="card cap">
                <span class={`cap-icon icon-${c.icon}`} aria-hidden="true" />
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <code class="cap-tag mono">{c.tag}</code>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Five minutes -->
    <section class="section band" id="start">
      <div class="container">
        <p class="eyebrow">Five minutes</p>
        <h2 class="section-title">Installed to gated, without reading a manual</h2>
        <p class="section-lede">
          The demo dataset ships inside the package, so the first artifact you see is real output
          from the real engine — not a screenshot.
        </p>

        <ol class="steps">
          {
            steps.map((s) => (
              <li class="step">
                <span class="step-n mono">{s.n}</span>
                <div>
                  <code class="step-cmd mono">{s.cmd}</code>
                  <p>{s.label}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Pipeline -->
    <section class="section" id="pipeline">
      <div class="container">
        <p class="eyebrow">How it works</p>
        <h2 class="section-title">From traces you already have to evidence you can defend</h2>
        <p class="section-lede">
          Six commands, no backend. Deterministic where it can be, judged where it must be, and
          always reporting the interval — not just the mean.
        </p>

        <ol class="flow">
          {
            pipeline.map((s, i) => (
              <li class="flow-step">
                <div class="flow-node">
                  <span class="flow-num mono">{i + 1}</span>
                  <span class="flow-cmd mono">{s.cmd}</span>
                </div>
                <p class="flow-label">{s.label}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Dimensions -->
    <section class="section band" id="dimensions">
      <div class="container">
        <p class="eyebrow">What it measures</p>
        <h2 class="section-title">Nine dimensions, each with a threshold and an interval</h2>
        <p class="section-lede">
          The verdict is a conjunction — one leak sinks the run. Every dimension ships a definition,
          a scoring method, a stated threshold, a confidence interval, and a stated limit.
        </p>

        <div class="dim-grid">
          {
            dimensions.map((d) => (
              <article class="card dim">
                <div class="dim-head">
                  <h3>{d.name}</h3>
                  <span class={`dim-mode mono ${d.mode === 'deterministic' ? 'det' : 'judge'}`}>
                    {d.mode}
                  </span>
                </div>
                <p class="dim-q">{d.q}</p>
                <div class="dim-bar mono">{d.bar}</div>
              </article>
            ))
          }
        </div>

        <p class="dim-note">
          Plus <strong>pass^k</strong> and run-to-run consistency over repeated trials. A dimension scoring
          0.667 with consistency 0.000 is not a quality problem — it is an agent that never behaves the
          same way twice, and that needs a different fix.
        </p>
        <p class="dim-links">
          <a href="/docs/dimensions" class="link-arrow">Every dimension in detail →</a>
          <a href={METHOD} class="link-arrow" target="_blank" rel="noopener noreferrer">
            Read the specification →
          </a>
        </p>
      </div>
    </section>

    <!-- CI gate -->
    <section class="section" id="ci">
      <div class="container ci-split">
        <div>
          <p class="eyebrow">In your build</p>
          <h2 class="section-title">Gate the release, not a dashboard</h2>
          <p class="section-lede">
            One step. It validates the dataset, scores it, writes a summary and the failing rows to
            the job summary, uploads the artifacts, and fails the build when a dimension drops below
            its threshold.
          </p>
          <p class="ci-note">
            The <code class="mono">env:</code> block is optional. Without a key, the deterministic dimensions
            still gate and the judged ones report as <strong>SKIPPED — never as passing</strong>.
            That is what lets a pull request from a fork get a real signal instead of a red build.
          </p>
          <a href="/docs/ci" class="link-arrow">CI &amp; the GitHub Action →</a>
        </div>

        <pre
          class="term ci-term"><span class="term-c">- uses:</span> assevra/assevra@v1
  <span class="term-c">with:</span>
    <span class="term-k">dataset:</span> evals/agent.jsonl
    <span class="term-k">gate:</span> true
    <span class="term-k">strict:</span> true
    <span class="term-k">attest:</span> true
  <span class="term-c">env:</span>
    <span class="term-k">ANTHROPIC_API_KEY:</span> &#36;&#123;&#123; secrets.ANTHROPIC_API_KEY &#125;&#125;</pre>
      </div>
    </section>

    <!-- Integrations -->
    <section class="section band" id="integrations">
      <div class="container">
        <p class="eyebrow">Fits what you already run</p>
        <h2 class="section-title">Assevra does not run your agent — it scores what you captured</h2>
        <p class="section-lede">
          That boundary is why it works with every framework instead of competing with them. One
          command prints the wiring for the tool you already use.
        </p>

        <div class="integ-grid">
          {
            integrations.map((i) => (
              <div class="integ">
                <span class="integ-name">{i.name}</span>
                <span class="integ-note mono">{i.note}</span>
              </div>
            ))
          }
        </div>

        <div class="integ-split">
          <pre class="term"><span class="term-prompt">$</span> assevra integrate langgraph</pre>
          <div class="providers">
            <p class="fw-label mono">Judge providers</p>
            <ul>
              {providers.map((p) => <li>{p}</li>)}
            </ul>
            <p class="providers-note">
              A local OpenAI-compatible endpoint needs no third-party package and sends nothing off
              the machine.
            </p>
          </div>
        </div>
        <a href="/docs/integrations" class="link-arrow">All integrations →</a>
      </div>
    </section>

    <!-- Case studies -->
    <section class="section" id="cases">
      <div class="container">
        <p class="eyebrow">Worked examples</p>
        <h2 class="section-title">Three runnable before/after walkthroughs</h2>
        <p class="section-lede">
          A real agent, a scorecard that fails, the exact rows that failed, the fix, and the
          scorecard that passes. Every number in them came from running the datasets in the repo.
        </p>

        <div class="case-grid">
          {
            cases.map((c) => (
              <a class="card case" href={c.href} target="_blank" rel="noopener noreferrer">
                <span class="case-dims mono">{c.dims}</span>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <span class="case-go">Open the walkthrough →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Signing / verify -->
    <section class="section band">
      <div class="container sign-split">
        <div class="sign-copy">
          <p class="eyebrow">Verifiable evidence</p>
          <h2 class="section-title">Signed, so a reviewer can trust it</h2>
          <p class="section-lede">
            A shared HTML file is convenient; a signed one is evidence. Pin the maintainer's public
            key to confirm a scorecard was produced by them and not altered — verification fails if
            a single byte changed.
          </p>
          <a href="/docs/security" class="link-arrow">Security &amp; signing →</a>
        </div>

        <div class="sign-box">
          <div class="key-block">
            <span class="key-label mono">Maintainer signing key · Ed25519</span>
            <code class="key mono">{SIGNING_KEY}</code>
          </div>
          <pre
            class="term"><span class="term-prompt">$</span> assevra verify \
  --scorecard scorecard.json \
  --signature scorecard.sig.json \
  --public-key &lt;key&gt;</pre>
        </div>
      </div>
    </section>

    <!-- Cite + CTA -->
    <section class="section cta-band">
      <div class="container cta-in">
        <div class="cta-copy">
          <h2 class="cta-title">Prove your agent behaves — and hand someone the receipt.</h2>
          <p>Install once, run offline, commit the artifact. No backend, no login, MIT-licensed.</p>
          <div class="hero-actions">
            <a href="/docs/getting-started" class="btn btn-primary">Get started →</a>
            <a href={GH} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              View on GitHub
            </a>
          </div>
        </div>
        <div class="cite card">
          <p class="cite-label eyebrow">Cite Assevra</p>
          <p class="cite-text">
            Divi, Veera Ravindra. <em>Assevra: A Reliability Scorecard for LLM Agents</em>, v0.4,
            2026.
          </p>
          <a href={DOI} class="mono cite-doi" target="_blank" rel="noopener noreferrer">
            DOI 10.5281/zenodo.21200852
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="ftr">
    <div class="container ftr-in">
      <div class="ftr-brand">
        <Image src={logo} alt="Assevra" widths={[170]} sizes="150px" class="ftr-logo" />
        <p>
          Release evidence for AI agents — an open reference implementation and named methodology
          for measuring agent reliability.
        </p>
      </div>
      <nav class="ftr-col" aria-label="Docs">
        <p class="ftr-h">Docs</p>
        <a href="/docs/getting-started">Getting started</a>
        <a href="/docs/dimensions">Dimensions</a>
        <a href="/docs/configuration">Configuration</a>
        <a href="/docs/cli">CLI reference</a>
        <a href="/docs/sdk">Python SDK</a>
      </nav>
      <nav class="ftr-col" aria-label="The artifact">
        <p class="ftr-h">The artifact</p>
        <a href={EXAMPLE}>Example scorecard</a>
        <a href="/docs/schemas">JSON schemas</a>
        <a href="/docs/security">Security &amp; signing</a>
        <a href="/docs/governance">Governance mapping</a>
        <a href={METHOD} target="_blank" rel="noopener noreferrer">Methodology spec</a>
      </nav>
      <nav class="ftr-col" aria-label="Project">
        <p class="ftr-h">Project</p>
        <a href={GH} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={PYPI} target="_blank" rel="noopener noreferrer">PyPI</a>
        <a href={ROADMAP} target="_blank" rel="noopener noreferrer">Roadmap</a>
